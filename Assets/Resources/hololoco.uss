/* Hololoco's app look: old Coupemon's hexagon game style, refreshed. Deep navy
   panels with silver edges, cyan accents, and hexagon buttons from the original art. */

.app { flex-grow: 1; }

.text { color: #e8eef5; font-size: 15px; white-space: normal; }
.title { font-size: 17px; -unity-font-style: bold; }
.muted { color: #9fb0c3; font-size: 13px; }
.big { font-size: 26px; -unity-font-style: bold; color: #ffffff; margin-bottom: 4px; }
.error { color: #ff8a80; font-size: 14px; }
.savings { color: #3fe0ff; font-size: 16px; -unity-font-style: bold; margin: 6px 0; }
.distance { color: #9fb0c3; font-size: 13px; margin: 4px 0 8px 0; }
.grow { flex-grow: 1; flex-shrink: 1; }
.row { flex-direction: row; align-items: center; }

.sheet-title {
    color: #3fe0ff;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 6px;
}

/* ---- top: status line and the level chip -------------------------------- */

.top {
    position: absolute;
    top: 34px;
    left: 12px;
    right: 12px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.status {
    position: absolute;
    top: 88px;
    left: 12px;
    max-width: 70%;
    padding: 6px 10px;
    border-radius: 8px;
    background-color: rgba(11, 18, 32, 0.85);
    color: #e8eef5;
    font-size: 13px;
    white-space: normal;
}

.chip {
    margin-left: auto;
    padding: 8px 16px;
    background-image: resource("Art/hex_button_back");
    -unity-background-scale-mode: stretch-to-fill;
    color: #3fe0ff;
    font-size: 14px;
    -unity-font-style: bold;
}

/* ---- the hexagon bar ------------------------------------------------------ */

.bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 104px;
    padding: 0 10px 14px 10px;
    flex-direction: row;
    justify-content: space-around;
    align-items: flex-end;
    background-color: rgba(8, 13, 24, 0.82);
    border-top-width: 1px;
    border-top-color: rgba(143, 163, 184, 0.45);
}

.hex-icon {
    width: 62px;
    height: 62px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.8;
}

.hex-icon.selected { opacity: 1; scale: 1.08 1.08; }
.hex-icon-big { width: 80px; height: 80px; margin-bottom: 4px; opacity: 1; }

/* ---- sheets over the map -------------------------------------------------- */

.sheet, .card-sheet {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 112px;
    padding: 16px;
    border-radius: 14px;
    background-color: rgba(13, 21, 36, 0.95);
    border-width: 1px;
    border-color: rgba(143, 163, 184, 0.55);
}

.sheet { top: 96px; }

.banner {
    position: absolute;
    top: 86px;
    left: 14px;
    right: 14px;
    padding: 12px 14px;
    border-radius: 12px;
    background-color: rgba(10, 60, 72, 0.95);
    border-width: 1px;
    border-color: #3fe0ff;
}

.toast {
    position: absolute;
    top: 150px;
    left: 24px;
    right: 24px;
    padding: 12px 14px;
    border-radius: 12px;
    background-color: rgba(8, 13, 24, 0.94);
    border-width: 1px;
    border-color: rgba(63, 224, 255, 0.6);
    color: #ffffff;
    font-size: 15px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.gem-dot {
    width: 18px;
    height: 18px;
    margin-right: 12px;
    border-radius: 4px;
    rotate: 45deg;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.7);
}

.buttons-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 6px;
}

.list { flex-grow: 1; margin-top: 8px; }

.item-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(143, 163, 184, 0.25);
}

.item-row.selected { background-color: rgba(63, 224, 255, 0.12); border-radius: 8px; }
.item-title { font-size: 15px; -unity-font-style: bold; }

.preview {
    height: 170px;
    margin-bottom: 8px;
    border-radius: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.bar-back { height: 10px; border-radius: 5px; background-color: rgba(143, 163, 184, 0.25); margin: 6px 0; }
.bar-fill { height: 10px; border-radius: 5px; background-color: #3fe0ff; }

.looks { flex-direction: row; flex-wrap: wrap; margin: 6px 0; }

/* ---- buttons -------------------------------------------------------------- */

.action {
    min-height: 46px;
    margin: 4px 8px 4px 0;
    padding: 0 22px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Art/hex_button_back");
    -unity-background-scale-mode: stretch-to-fill;
    color: #e8eef5;
    font-size: 15px;
    -unity-font-style: bold;
}

.action.hex-primary {
    -unity-background-image-tint-color: #2fb8d4;
    color: #04131c;
    letter-spacing: 1px;
}

.action.hex-secondary { color: #e8eef5; }

.action.link {
    background-image: none;
    color: #9fb0c3;
    -unity-font-style: normal;
    padding: 0 6px;
}

.action.close {
    background-image: none;
    min-height: 40px;
    padding: 0 10px;
    margin: 0;
    font-size: 22px;
    color: #9fb0c3;
}

.action.look {
    min-height: 38px;
    padding: 0 14px;
    font-size: 13px;
    -unity-font-style: normal;
}

.action.look.selected { -unity-background-image-tint-color: #2fb8d4; color: #04131c; }
.action:disabled { opacity: 0.45; }

/* ---- AR -------------------------------------------------------------------- */

.ar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: space-between;
    padding: 46px 16px 34px 16px;
}

.ar-hint { align-items: center; margin-top: 40px; }
.ar-hint-picture { width: 120px; height: 120px; -unity-background-scale-mode: scale-to-fit; opacity: 0.9; }
.ar-hint-text {
    margin-top: 14px;
    padding: 8px 14px;
    border-radius: 8px;
    background-color: rgba(8, 13, 24, 0.7);
    color: #ffffff;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.ar-head {
    align-items: center;
    padding: 12px;
    border-radius: 12px;
    background-color: rgba(8, 13, 24, 0.72);
}

.ar-title { font-size: 20px; -unity-font-style: bold; color: #ffffff; -unity-text-align: middle-center; }
.ar-sub { font-size: 15px; color: #3fe0ff; -unity-text-align: middle-center; }
.ar-xp { font-size: 40px; -unity-font-style: bold; color: #3fe0ff; -unity-text-align: middle-center; }

.ar-bottom { flex-direction: row; justify-content: center; }
.ar-bottom > .action { min-height: 58px; padding: 0 34px; font-size: 17px; margin: 0 8px; }

/* ---- dialogs ----------------------------------------------------------------- */

.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(4, 8, 16, 0.72);
    justify-content: center;
    padding: 20px;
}

.overlay.at-top { justify-content: flex-start; padding-top: 52px; }

.dialog {
    padding: 18px;
    border-radius: 14px;
    background-color: #0f1a2c;
    border-width: 1px;
    border-color: rgba(143, 163, 184, 0.6);
}

.code {
    font-size: 46px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    margin: 18px 0;
    color: #3fe0ff;
}

/* ---- fields ------------------------------------------------------------------ */

TextField { margin: 6px 0; flex-direction: column; }
TextField > Label { color: #9fb0c3; font-size: 13px; min-width: 0; margin-bottom: 4px; }
TextField > .unity-base-text-field__input {
    min-height: 44px;
    font-size: 16px;
    border-radius: 8px;
    background-color: #16233a;
    border-color: rgba(143, 163, 184, 0.5);
    color: #ffffff;
}
TextField.multiline > .unity-base-text-field__input { min-height: 80px; -unity-text-align: upper-left; }

.switch { margin: 8px 0; }
.switch > Label { color: #e8eef5; font-size: 15px; }

/* The quick switch to the dark game map, on the map itself. */
.map-toggle {
    padding: 6px 12px;
    border-radius: 18px;
    background-color: rgba(8, 13, 24, 0.82);
    border-width: 1px;
    border-color: rgba(143, 163, 184, 0.55);
    margin: 0;
}
.map-toggle > Label { color: #e8eef5; font-size: 14px; -unity-font-style: bold; min-width: 0; margin-right: 6px; }
